// Smart Energie Stolp (SES): C4 model, levels 1 to 3
// Docs: https://likec4.dev/
//
// Modelling rule: between two elements there is exactly one relationship,
// and every view only shows the relationships of its own C4 level.

specification {
  element actor
  element system
  element container
  element component

  tag ui {
    color #33B074
  }
  tag version1 {
    color #D6409F
  }
  tag warn

  // Relationship levels, used to show each level in its own view
  tag level1
  tag level2
  tag level3
}

model {

  // ═══════════════ Level 1: actors and external sources ═══════════════

  customer = actor 'Small energy consumers' {
    description 'Participants of the energy community who view their own data and advice'
    style {
      shape person
      color muted
    }
  }

  admin = actor 'System administrator' {
    description 'Administrator who imports data and manages the system'
    style {
      shape person
      color muted
    }
  }

  meterData = actor 'Meter data' {
    description 'CSV export with quarter-hourly readings per meter, delivered a few times per year'
    style {
      color muted
    }
  }

  weatherData = actor 'Weather data' {
    description 'Weather forecast for the next 48 hours and historical weather archive'
    style {
      color muted
    }
  }

  // ═══════════════ Level 2 and 3: system, containers and components ═══════════════

  ses = system 'Smart Energie Stolp' {
    #version1
    description 'Calculates, forecasts and improves the simultaneity of local energy generation and consumption'

    // ─────────── Web app ───────────
    container webapp 'Web app' {
      #ui #warn
      description 'User interface for participants and administrators (front-end framework still to be chosen)'
      style {
        shape browser
      }

      component loginPage 'Login page' {
        description 'Login page for all users'
      }
      component authentication 'Authentication' {
        description 'Manages sessions and permissions per role'
      }
      component dataImport 'Data import' {
        description 'Lets the administrator upload new meter data through the frontend API'
      }
      component dataView 'Data view' {
        description 'Shows participants their own consumption, generation and advice'
      }
      component settings 'Settings' {
        description 'Lets the administrator manage system settings'
      }
      component apiClient 'API client' {
        description 'Sends all requests from the web app to the frontend API'
      }

      loginPage -> authentication 'submits credentials'
      authentication -> apiClient 'verifies user and role'
      authentication -> dataView 'grants access for participants'
      authentication -> dataImport 'grants access for administrators'
      authentication -> settings 'grants access for administrators'
      dataView -> apiClient 'requests own data and advice'
      settings -> apiClient 'reads and saves settings'
      dataImport -> apiClient 'uploads CSV file'
    }

    // ─────────── Frontend API ───────────
    container frontendAPI 'Frontend API' {
      description 'Single entry point for the web app: database queries and data uploads'
      style {
        size small
      }

      component apiEndpoints 'API endpoints' {
        description 'Receives requests, routes them and returns the result'
      }
      component authentication 'Authentication' {
        description 'Checks who makes the request and whether it is allowed'
      }
      component queryBuilder 'Query builder' {
        description 'Translates a request into a valid database query'
      }
      component queryExecutor 'Query executor' {
        description 'Sends the query to the database and returns the result'
      }

      component uploadHandler 'Upload handler' {
        description 'Accepts CSV uploads from administrators, checks file type and size and forwards them to the ingest service'
      }

      apiEndpoints -> authentication 'verifies caller and permissions'
      apiEndpoints -> queryBuilder 'passes validated request'
      queryBuilder -> queryExecutor 'passes query'
      apiEndpoints -> uploadHandler 'passes authorised upload'
    }

    // ─────────── Backend API ───────────
    container backendAPI 'Backend API' {
      description 'API between the backend services and the database'
      style {
        size small
      }

      component apiEndpoints 'API endpoints' {
        description 'Receives requests, routes them and returns the result'
      }
      component authentication 'Authentication' {
        description 'Checks which service makes the request and whether it is allowed'
      }
      component queryBuilder 'Query builder' {
        description 'Translates a request into a valid database query'
      }
      component queryExecutor 'Query executor' {
        description 'Sends the query to the database and returns the result'
      }

      apiEndpoints -> authentication 'verifies caller and permissions'
      apiEndpoints -> queryBuilder 'passes validated request'
      queryBuilder -> queryExecutor 'passes query'
    }

    // ─────────── Ingest service ───────────
    container ingestService 'Ingest service' {
      description 'Imports meter data and links every meter to the right participant'

      component fileReceiver 'File receiver' {
        description 'Receives the meter data file from the frontend API and records file name, hash and period'
      }
      component csvParser 'CSV parser' {
        description 'Parses decimal commas and merges date and time into a UTC timestamp'
      }
      component validator 'Validator' {
        description 'Detects duplicates, marks gaps (not as zero) and checks limits per meter'
      }
      component meterLinker 'Meter linker' {
        description 'Links meter_reference to participant_id using the client\'s linking tool'
      }
      component backendClient 'Backend client' {
        description 'Reads meter links and writes readings and import records through the backend API'
      }
      component importNotifier 'Import notifier' {
        description 'Notifies the calculation service that new data has been imported'
        style {
          size small
        }
      }

      fileReceiver -> csvParser 'passes raw CSV'
      csvParser -> validator 'passes parsed rows'
      validator -> meterLinker 'passes valid rows'
      meterLinker -> backendClient 'requests meter links and passes linked rows'
      backendClient -> importNotifier 'reports completed import'
    }

    // ─────────── Calculation service ───────────
    container calculationService 'Calculation service' {
      description 'Calculates simultaneity per quarter hour'

      component calculationTrigger 'Calculation trigger' {
        description 'Starts a recalculation for the changed period'
        style {
          size small
        }
      }
      component simultaneityCalculator 'Simultaneity calculator' {
        description 'Shared energy = min(surplus, consumption) per quarter hour'
      }

      calculationTrigger -> simultaneityCalculator 'starts calculation'
    }

    // ─────────── ML service ───────────
    container mlService 'ML service' {
      description 'Forecasts generation and consumption and generates personal advice'

      // After every export, a few times per year
      component effectMeasurement 'Effect measurement' {
        description 'Compares actual consumption with the P50 forecast to measure whether advice was followed'
      }
      component retraining 'Retraining' {
        description 'Retrains the forecasters, clusters and acceptance model on new data'
      }
      component modelRegistry 'Model registry' {
        description 'MLflow registry with model versions and test scores; a new model goes live only if it scores better'
        style {
          shape storage
        }
      }

      // Every evening, automatically
      component weatherForecast 'Weather forecast' {
        description 'Fetches irradiance, cloud cover and temperature for the next 48 hours'
      }
      component forecasting 'Forecasting' {
        description 'Forecasts generation and consumption per quarter hour with P10 to P90 bands (LightGBM)'
      }
      component optimization 'Optimization' {
        description 'Schedules flexible appliances into unused surplus within comfort limits (MILP)'
      }
      component ranking 'Ranking' {
        description 'Ranks advice by expected gain times chance of being followed and selects the top 3'
      }

      // Shared
      component dataAccess 'Data access' {
        description 'Single gateway from the ML service to the backend API'
        style {
          size small
        }
      }

      effectMeasurement -> retraining 'provides measured effect of advice'
      retraining -> modelRegistry 'registers new models'
      weatherForecast -> forecasting 'provides weather features'
      forecasting -> optimization 'provides forecast surplus (P10)'
      optimization -> ranking 'provides candidate advice'
      modelRegistry -> forecasting 'provides trained models'
      modelRegistry -> ranking 'provides trained models'

      effectMeasurement -> dataAccess 'reads given advice and readings'
      retraining -> dataAccess 'reads training data'
      forecasting -> dataAccess 'reads history, writes forecasts'
      optimization -> dataAccess 'reads comfort limits and appliances'
      ranking -> dataAccess 'writes top 3 advice'
    }

    // ─────────── Database ───────────
    container database 'Database' {
      description 'PostgreSQL with TimescaleDB for readings, links, forecasts and advice'
      style {
        shape storage
      }

      component sqlInterface 'SQL interface' {
        description 'PostgreSQL endpoint with a separate role per API; the frontend role only sees participant data'
        style {
          size small
        }
      }
      component readings 'readings' {
        description 'Hypertable with meter_id, UTC timestamp, to_grid, from_grid, created_at and import_id'
        style {
          shape storage
        }
      }
      component meterLinks 'meter_links' {
        description 'Links meter_id to participant_id'
        style {
          shape storage
        }
      }
      component participants 'participants' {
        description 'Pseudonym, connection type, comfort limits and appliances'
        style {
          shape storage
        }
      }
      component simultaneity 'simultaneity' {
        description 'Shared kWh per quarter hour and participant'
        style {
          shape storage
        }
      }
      component forecasts 'forecasts' {
        description 'Forecast generation and consumption per quarter hour'
        style {
          shape storage
        }
      }
      component advice 'advice' {
        description 'Given advice, feedback and measured effect'
        style {
          shape storage
        }
      }
      component importLog 'import_log' {
        description 'File, hash, period, row count and new meters per import'
        style {
          shape storage
        }
      }

      sqlInterface -> readings 'stores and queries'
      sqlInterface -> meterLinks 'stores and queries'
      sqlInterface -> participants 'stores and queries'
      sqlInterface -> simultaneity 'stores and queries'
      sqlInterface -> forecasts 'stores and queries'
      sqlInterface -> advice 'stores and queries'
      sqlInterface -> importLog 'stores and queries'
    }
  }

  // ═══════════════ Relationships ═══════════════
  // Every pair of elements has exactly one relationship. Each level is modelled
  // explicitly and tagged, so a view only shows the relationships of its own level:
  //   #level1  context:    actor -> system
  //   #level2  containers: actor -> container, container -> container
  //   #level3  components: crossing a container boundary at component level

  // ─────────── Data delivery (shown in every view that contains both) ───────────
  meterData -> admin 'is delivered as CSV export to'

  // ─────────── Level 1: context ───────────
  customer -> ses 'views own energy data and advice' {
    #level1
  }
  admin -> ses 'imports meter data and manages the system' {
    #level1
  }
  weatherData -> ses 'provides weather forecasts and history' {
    #level1
  }

  // ─────────── Level 2: containers ───────────
  customer -> ses.webapp 'views own data and advice' {
    #level2
  }
  admin -> ses.webapp 'imports meter data and manages settings' {
    #level2
  }
  weatherData -> ses.mlService 'provides weather data over HTTPS' {
    #level2
  }
  ses.webapp -> ses.frontendAPI 'sends requests and uploads over HTTPS' {
    #level2
  }
  ses.frontendAPI -> ses.ingestService 'forwards uploaded CSV file' {
    #level2
  }
  ses.ingestService -> ses.backendAPI 'reads meter links, writes readings and import records' {
    #level2
  }
  ses.ingestService -> ses.calculationService 'reports new data' {
    #level2
  }
  ses.calculationService -> ses.backendAPI 'reads readings, writes simultaneity' {
    #level2
  }
  ses.calculationService -> ses.mlService 'reports new results' {
    #level2
  }
  ses.mlService -> ses.backendAPI 'reads and writes forecasts, advice and training data' {
    #level2
  }
  ses.frontendAPI -> ses.database 'reads participant data, writes settings and feedback' {
    #level2
  }
  ses.backendAPI -> ses.database 'reads and writes readings, links, results and advice' {
    #level2
  }

  // ─────────── Level 3: components across container boundaries ───────────
  customer -> ses.webapp.loginPage 'logs in to view own data and advice' {
    #level3
  }
  admin -> ses.webapp.loginPage 'logs in to import data and manage settings' {
    #level3
  }
  weatherData -> ses.mlService.weatherForecast 'provides weather data over HTTPS' {
    #level3
  }
  ses.webapp.apiClient -> ses.frontendAPI.apiEndpoints 'sends requests and uploads over HTTPS' {
    #level3
  }
  ses.frontendAPI.uploadHandler -> ses.ingestService.fileReceiver 'forwards uploaded CSV file' {
    #level3
  }
  ses.ingestService.backendClient -> ses.backendAPI.apiEndpoints 'reads meter links, writes readings and import records' {
    #level3
  }
  ses.ingestService.importNotifier -> ses.calculationService.calculationTrigger 'reports new data' {
    #level3
  }
  ses.calculationService.simultaneityCalculator -> ses.backendAPI.apiEndpoints 'reads readings, writes simultaneity' {
    #level3
  }
  ses.calculationService.simultaneityCalculator -> ses.mlService.effectMeasurement 'reports new results' {
    #level3
  }
  ses.mlService.dataAccess -> ses.backendAPI.apiEndpoints 'reads and writes forecasts, advice and training data' {
    #level3
  }
  ses.frontendAPI.queryExecutor -> ses.database.sqlInterface 'reads participant data, writes settings and feedback' {
    #level3
  }
  ses.backendAPI.queryExecutor -> ses.database.sqlInterface 'reads and writes readings, links, results and advice' {
    #level3
  }
}

views {

  // ═══════════════ Level 1 ═══════════════
  view index {
    title '1 - Context'
    include *
    exclude * -> * where tag is #level2 or tag is #level3
  }

  // ═══════════════ Level 2 ═══════════════
  // Every container links to its own level 3 view (click to open)
  view ses of ses {
    title '2 - Containers'
    include *
    include meterData
    exclude * -> * where tag is #level1 or tag is #level3
    autoLayout TopBottom 200 205
  }

  // ═══════════════ Level 3 ═══════════════
  // include * shows the components plus every element outside the container they talk to;
  // only level 3 relationships are shown
  view webappDetail of ses.webapp {
    title '3.1 - Web app'
    include *
    exclude * -> * where tag is #level1 or tag is #level2
  }

  view ingestDetail of ses.ingestService {
    title '3.2 - Ingest service'
    include *
    exclude * -> * where tag is #level1 or tag is #level2
  }

  view databaseDetail of ses.database {
    title '3.3 - Database'
    include *
    exclude * -> * where tag is #level1 or tag is #level2
  }

  view calculationDetail of ses.calculationService {
    title '3.4 - Calculation service'
    include *
    exclude * -> * where tag is #level1 or tag is #level2
  }

  view backendApiDetail of ses.backendAPI {
    title '3.5 - Backend API'
    include *
    exclude * -> * where tag is #level1 or tag is #level2
  }

  view frontendApiDetail of ses.frontendAPI {
    title '3.6 - Frontend API'
    include *
    exclude * -> * where tag is #level1 or tag is #level2
  }

  view mlDetail of ses.mlService {
    title '3.7 - ML service'
    include *
    exclude * -> * where tag is #level1 or tag is #level2
  }

  // All components in one view
  view components {
    title '3 - Components'
    include ses.**
    include customer, admin, meterData, weatherData
    exclude * -> * where tag is #level1 or tag is #level2
    style ses.** {
      size small
    }
    autoLayout TopBottom 60 40
  }
}
