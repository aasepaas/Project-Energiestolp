// Smart Energie Stolp (SES): C4 model, levels 1 to 3
// Docs: https://likec4.dev/

specification {
  element actor
  element system
  element container
  element component

  tag ui {
    color #33B074
  }
  tag version1 {
    color #D6409F
  }
  tag warn
}

model {

  // ═══════════════ Level 1: actors and external sources ═══════════════

  customer = actor 'Klein energieverbruikers' {
    description 'Participants of the energy community who view their own data and advice'
    style {
      shape person
      color muted
    }
  }

  beheerder = actor 'Systeembeheerder' {
    description 'Administrator who imports data and manages the system'
    style {
      shape person
      color muted
    }
  }

  meterdata = actor 'Meterdata' {
    description 'CSV export with quarter-hourly readings per meter, delivered a few times per year'
    style {
      color muted
    }
  }

  weerdata = actor 'Weerdata' {
    description 'Weather forecast for the next 48 hours and historical weather archive'
    style {
      color muted
    }
  }

  // ═══════════════ Level 2 and 3: system, containers and components ═══════════════

  ses = system 'Smart Energie Stolp' {
    #version1
    description 'Calculates, forecasts and improves the simultaneity of local energy generation and consumption'

    // ─────────── Web app ───────────
    container webapp 'Web app' {
      #ui #warn
      description 'User interface for participants and administrators (front-end framework still to be chosen)'
      style {
        shape browser
      }

      component inlogpagina 'Inlogpagina' {
        description 'Login page for all users'
      }
      component authenticatie 'Authenticatie' {
        description 'Manages sessions and permissions per role'
      }
      component dataImport 'Data-import' {
        description 'Lets the administrator upload new meter data for the ingest service'
      }
      component dataInzien 'Data inzien' {
        description 'Shows participants their own consumption, generation and advice'
      }
      component instellingen 'Instellingen' {
        description 'Lets the administrator manage system settings'
      }
      component apiClient 'API-client' {
        description 'Sends all requests from the web app to the frontend API'
      }

      inlogpagina -> authenticatie 'submits credentials'
      authenticatie -> apiClient 'verifies user and role'
      dataInzien -> apiClient 'requests own data and advice'
      instellingen -> apiClient 'reads and saves settings'
    }

    // ─────────── Frontend API ───────────
    container frontendAPI 'Frontend API' {
      description 'API between the web app and the database'
      style {
        size small
      }

      component apiEndpoints 'API-endpoints' {
        description 'Receives requests, routes them and returns the result'
      }
      component authenticatie 'Authenticatie' {
        description 'Checks who makes the request and whether it is allowed'
      }
      component queryMaker 'Query maker' {
        description 'Translates a request into a valid database query'
      }
      component querySender 'Query verstuurder' {
        description 'Sends the query to the database and returns the result'
      }

      apiEndpoints -> authenticatie 'verifies caller and permissions'
      apiEndpoints -> queryMaker 'passes validated request'
      queryMaker -> querySender 'passes query'
    }

    // ─────────── Backend API ───────────
    container backendAPI 'Backend API' {
      description 'API between the backend services and the database'
      style {
        size small
      }

      component apiEndpoints 'API-endpoints' {
        description 'Receives requests, routes them and returns the result'
      }
      component authenticatie 'Authenticatie' {
        description 'Checks which service makes the request and whether it is allowed'
      }
      component queryMaker 'Query maker' {
        description 'Translates a request into a valid database query'
      }
      component querySender 'Query verstuurder' {
        description 'Sends the query to the database and returns the result'
      }

      apiEndpoints -> authenticatie 'verifies caller and permissions'
      apiEndpoints -> queryMaker 'passes validated request'
      queryMaker -> querySender 'passes query'
    }

    // ─────────── Ingest service ───────────
    container ingestService 'Ingest service' {
      description 'Imports meter data and links every meter to the right participant'

      component ontvanger 'Bestandsontvanger' {
        description 'Receives the meter data file and logs file name, hash and period'
      }
      component csvParser 'CSV parser' {
        description 'Parses decimal commas and merges date and time into a UTC timestamp'
      }
      component validator 'Validator' {
        description 'Detects duplicates, marks gaps (not as zero) and checks limits per meter'
      }
      component meterKoppelaar 'Meterkoppelaar' {
        description 'Links meter_reference to participant_id using the client\'s linking tool'
      }
      component writer 'Writer' {
        description 'Writes validated readings to the database through the backend API'
      }
      component importNotifier 'Importnotifier' {
        description 'Notifies the calculation service that new data has been imported'
        style {
          size small
        }
      }

      ontvanger -> csvParser 'passes raw CSV'
      csvParser -> validator 'passes parsed rows'
      validator -> meterKoppelaar 'passes valid rows'
      meterKoppelaar -> writer 'passes linked rows'
      writer -> importNotifier 'reports completed import'
    }

    // ─────────── Reken service ───────────
    container rekenservice 'Reken service' {
      description 'Calculates simultaneity per quarter hour'

      component rekenTrigger 'Rekentrigger' {
        description 'Starts a recalculation for the changed period'
        style {
          size small
        }
      }
      component gelijktijdigheid 'Gelijktijdigheidsberekening' {
        description 'Shared energy = min(surplus, consumption) per quarter hour'
      }

      rekenTrigger -> gelijktijdigheid 'starts calculation'
    }

    // ─────────── ML service ───────────
    container MLservice 'ML service' {
      description 'Forecasts generation and consumption and generates personal advice'

      // After every export, a few times per year
      component effectmeting 'Effectmeting' {
        description 'Compares actual consumption with the P50 forecast to measure whether advice was followed'
      }
      component hertrainen 'Hertrainen' {
        description 'Retrains the forecasters, clusters and acceptance model on new data'
      }
      component modelregister 'Modelregister' {
        description 'MLflow registry with model versions and test scores; a new model goes live only if it scores better'
        style {
          shape storage
        }
      }

      // Every evening, automatically
      component weersverwachting 'Weersverwachting' {
        description 'Fetches irradiance, cloud cover and temperature for the next 48 hours'
      }
      component voorspellen 'Voorspellen' {
        description 'Forecasts generation and consumption per quarter hour with P10 to P90 bands (LightGBM)'
      }
      component optimaliseren 'Optimaliseren' {
        description 'Schedules flexible appliances into unused surplus within comfort limits (MILP)'
      }
      component rangschikken 'Rangschikken' {
        description 'Ranks advice by expected gain times chance of being followed and selects the top 3'
      }

      effectmeting -> hertrainen 'provides measured effect of advice'
      hertrainen -> modelregister 'registers new models'
      weersverwachting -> voorspellen 'provides weather features'
      voorspellen -> optimaliseren 'provides forecast surplus (P10)'
      optimaliseren -> rangschikken 'provides candidate advice'
      modelregister -> voorspellen 'provides trained models'
      modelregister -> rangschikken 'provides trained models'
    }

    // ─────────── Database ───────────
    container database 'Database' {
      description 'PostgreSQL with TimescaleDB for readings, links, forecasts and advice'
      style {
        shape storage
      }

      component tblMeetdata 'meetdata' {
        description 'Hypertable with meter_id, UTC timestamp, to_grid, from_grid, created_at and import_id'
        style {
          shape storage
        }
      }
      component tblKoppel 'koppeltabel' {
        description 'Links meter_id to participant_id'
        style {
          shape storage
        }
      }
      component tblDeelnemer 'deelnemers' {
        description 'Pseudonym, connection type, comfort limits and appliances'
        style {
          shape storage
        }
      }
      component tblResultaat 'gelijktijdigheid' {
        description 'Shared kWh per quarter hour and participant'
        style {
          shape storage
        }
      }
      component tblVoorspelling 'voorspellingen' {
        description 'Forecast generation and consumption per quarter hour'
        style {
          shape storage
        }
      }
      component tblAdvies 'adviezen' {
        description 'Given advice, feedback and measured effect'
        style {
          shape storage
        }
      }
      component tblImportlog 'importlog' {
        description 'File, hash, period, row count and new meters per import'
        style {
          shape storage
        }
      }
    }
  }

  // ═══════════════ Relationships between containers and with the outside ═══════════════

  // Users
  customer -> ses.webapp.inlogpagina 'logs in'
  customer -> ses.webapp.dataInzien 'views own data and advice'
  beheerder -> ses.webapp.inlogpagina 'logs in'
  beheerder -> ses.webapp.dataImport 'uploads meter data'
  beheerder -> ses.webapp.instellingen 'manages settings'

  // External sources
  meterdata -> ses.ingestService.ontvanger 'provides CSV export'
  weerdata -> ses.MLservice.weersverwachting 'provides weather data over HTTPS'

  // Web app
  ses.webapp.apiClient -> ses.frontendAPI.apiEndpoints 'sends requests over HTTPS'
  ses.webapp.dataImport -> ses.ingestService.ontvanger 'uploads CSV file'

  // Ingest service
  ses.ingestService.ontvanger -> ses.backendAPI.apiEndpoints 'registers import'
  ses.ingestService.meterKoppelaar -> ses.backendAPI.apiEndpoints 'reads meter links'
  ses.ingestService.writer -> ses.backendAPI.apiEndpoints 'writes validated readings'
  ses.ingestService.importNotifier -> ses.rekenservice.rekenTrigger 'reports new data'

  // Reken service
  ses.rekenservice.gelijktijdigheid -> ses.backendAPI.apiEndpoints 'reads readings, writes simultaneity'
  ses.rekenservice.gelijktijdigheid -> ses.MLservice.effectmeting 'reports new results'

  // ML service
  ses.MLservice.effectmeting -> ses.backendAPI.apiEndpoints 'reads given advice and readings'
  ses.MLservice.hertrainen -> ses.backendAPI.apiEndpoints 'reads training data'
  ses.MLservice.voorspellen -> ses.backendAPI.apiEndpoints 'reads history, writes forecasts'
  ses.MLservice.optimaliseren -> ses.backendAPI.apiEndpoints 'reads comfort limits and appliances'
  ses.MLservice.rangschikken -> ses.backendAPI.apiEndpoints 'writes top 3 advice'

  // Frontend API to database
  ses.frontendAPI.querySender -> ses.database.tblMeetdata 'reads own readings'
  ses.frontendAPI.querySender -> ses.database.tblResultaat 'reads own simultaneity'
  ses.frontendAPI.querySender -> ses.database.tblVoorspelling 'reads forecasts'
  ses.frontendAPI.querySender -> ses.database.tblAdvies 'reads advice, writes feedback'
  ses.frontendAPI.querySender -> ses.database.tblDeelnemer 'reads and writes settings'

  // Backend API to database
  ses.backendAPI.querySender -> ses.database.tblMeetdata 'upserts and reads readings'
  ses.backendAPI.querySender -> ses.database.tblKoppel 'reads meter links'
  ses.backendAPI.querySender -> ses.database.tblImportlog 'writes import records'
  ses.backendAPI.querySender -> ses.database.tblResultaat 'reads and writes simultaneity'
  ses.backendAPI.querySender -> ses.database.tblVoorspelling 'reads and writes forecasts'
  ses.backendAPI.querySender -> ses.database.tblAdvies 'reads and writes advice'
  ses.backendAPI.querySender -> ses.database.tblDeelnemer 'reads comfort limits and appliances'
}

views {

  // ═══════════════ Level 1 ═══════════════
  view index {
    title '1 - Context'
    include *
  }

  // ═══════════════ Level 2 ═══════════════
  // Every container links to its own level 3 view (click to open)
  view ses of ses {
    title '2 - Containers'
    include *
    autoLayout TopBottom 200 205
  }

  // ═══════════════ Level 3 ═══════════════
  // include * shows the components plus every element outside the container they talk to
  view webappDetail of ses.webapp {
    title '3.1 - Web app'
    include *
  }

  view ingestDetail of ses.ingestService {
    title '3.2 - Ingest service'
    include *
  }

  view databaseDetail of ses.database {
    title '3.3 - Database'
    include *
  }

  view rekenDetail of ses.rekenservice {
    title '3.4 - Reken service'
    include *
  }

  view backendApiDetail of ses.backendAPI {
    title '3.5 - Backend API'
    include *
  }

  view frontendApiDetail of ses.frontendAPI {
    title '3.6 - Frontend API'
    include *
  }

  view mlDetail of ses.MLservice {
    title '3.7 - ML service'
    include *
  }

  // All components in one view
  view componenten {
    title '3 - Componenten'
    include ses.**
    include customer, beheerder, meterdata, weerdata
  }
}
