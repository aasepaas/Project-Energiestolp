// Tutorial:
// https://likec4.dev/tutorial/

specification {
  element actor
  element system
  element component
  element service
  element container


  tag ui {
    color #33B074
  }
  tag version1 {
    color #D6409F
  }
  tag warn
}

model {
  customer = actor 'Klein energieverbruikers' {
    description ''
    style {
      color muted
    }
  }

  beheerder = actor 'Systeembeheerder' {
    description ''
    style {
      color muted
    }
  }

  meterdata = actor 'Meterdata' {
    description 'Kwartierwaarden per meter die gekoppeld is aan klant'
    style {
      color muted
    }
  }

  weerdata = actor 'Weerdata' {
    description 'Weerdata van de komende 24 uur'
    style {
      color muted
    }
  }

  saas = system 'Energiegelijktijdigheid systeem' {
    #version1

    service webapp 'Web app' {
      #ui #warn
      description '{interface tool moet nog gekozen worden}'
      style {
        shape browser
      }
      component inlogpagina 'Inlogpagina' {
        description 'Log in pagina voor gebruikers'
      }
      component authenticatie 'Authenticatie' {
        description 'Sessiebeheer en rechten per rol'
      }
      component ingestBestandenPagina 'Data-import' {
        description 'Uploaden van nieuwe data door beheerder voor de ingest service'
      }
      component inzienDataPagina 'Data inzien' {
        description 'Inzien van eigen data meetdata door gebruikers'
      }
      component API-client 'API-client ' {
        description 'Communicatie met de frontend API '
      }
      component instellingen 'Instellingen' {
        description 'Instellingen selecteren door beheerder'
      }
      API-client -> frontendAPI
      API-client -> frontendAPI.API-endpoints
    }

    service ingestService 'Ingest service' {
      description '
        Binnenkomend data moet gekoppeld worden aan juiste klant
      '

      component ontvanger 'Bestandsontvanger' {
        description 'Ontvangt meterdata bestand, legt bestand, hash en periode vast in importlog'
      }
      component CSV-parser 'CSV parser' {
        description 'Leest CSV-bestand en zet komma als decimaal, datum en tijd samengevoegd tot UTC-tijdstempel'
      }
      component validator 'Validator' {
        description 'Dubbelingen, gaten (niet als 0) en grenzen per meter'
      }
      component meterKoppelaar 'Meterkoppelaar' {
        description 'Koppelt meter_reference aan deelnemer_id, met tool van opdrachtgever'
      }
      component writer 'Writer' {
        description 'Schrijft gevalideerde data naar database via backend API'
      }
      component importNotifier 'Importnotifier' {
        description 'Stuurt notificatie naar ML service dat er nieuwe data is ingelezen en verwerkt'
        style {
          size small
        }
      }

      ontvanger -> CSV-parser 'geeft ruwe CSV door'
      CSV-parser -> validator 'geeft rijen door'
      validator -> meterKoppelaar 'geeft geldige rijen door'
      meterKoppelaar -> writer 'geeft gekoppelde rijen door'
      writer -> backendAPI 'schrijft naar database'
      writer -> importNotifier 'maakt melding dat er nieuwe data is ingelezen'
      importNotifier -> rekenTrigger 'meldt dat er nieuwe data is ingelezen'



    }

    service database 'Database' {
      description '
        Meetdata per deelnemer, koppeltabel, voorspellings en adviezen
      '
      style {
        shape storage
      }

      component tblMeetdata 'meetdata' {
        description 'Hypertable: meter_id, tijdstempel UTC, to_grid, from_grid, created_at, import_id'
        style {
          shape storage
        }
      }
      component tblKoppel 'koppeltabel' {
        description 'meter_id, deelnemer_id'
        style {
          shape storage
        }
      }
      component tblDeelnemer 'deelnemers' {
        description 'Pseudoniem, type aansluiting, comfortgrenzen en apparaten'
        style {
          shape storage
        }
      }
      component tblResultaat 'gelijktijdigheid' {
        description 'Gedeelde kWh per kwartier en deelnemer'
        style {
          shape storage
        }
      }
      component tblVoorspelling 'voorspellingen' {
        description 'Voorspelde opwek en verbruik per kwartier'
        style {
          shape storage
        }
      }
      component tblAdvies 'adviezen' {
        description 'Gegeven adviezen, feedback en gemeten effect'
        style {
          shape storage
        }
      }
      component tblImportlog 'importlog' {
        description 'Bestand, hash, periode, aantal rijen, nieuwe meters'
        style {
          shape storage
        }
      }
    }

    service rekenservice 'Reken service' {
      description '
        Berekenen gelijktijdigheid op kwartiersbasis 
      '

      component rekenTrigger 'Rekentrigger' {
        description 'Start een herberekening voor de gewijzigde periode'
        style {
          size small
        }
      }

      component gelijktijdigheid 'Gelijktijdigheidsberekening' {
        description 'Gedeeld = min(overschot, afname) per kwartier'
      }


      rekenTrigger -> gelijktijdigheid 'start berekening gelijktijdigheid'
      gelijktijdigheid -> backendAPI 'schrijft berekende gelijktijdigheid'
      gelijktijdigheid -> MLservice 'meldt dat er nieuwe data is berekend'

    }

    service backendAPI 'Backend API' {
      description '
        API die communiceert met de database vanuit de backend
      '
      style {
        size small
      }
      component API-endpoints 'API-endpoints' {
        description 'Ontvangt verzoeken, stuurt ze door en geeft een resultaat terug'
      }
      component authenticatie 'Authenticatie' {
        description 'Authenticeren wie het verzoek doet en of het mag'
      }
      component queryMaker 'Query maker' {
        description 'Vertaalt verzoeken naar een geldige database query'
      }
      component querySender 'Query verstuurder' {
        description 'Verstuurt de query naar de database en ontvangt het resultaat hiervan'
      }
      API-endpoints -> authenticatie
      API-endpoints -> queryMaker
      API-endpoints -> querySender
      querySender -> database
    }

    service frontendAPI 'Frontend API' {
      description '
        API die communiceert met de database vanuit de frontend
      '
      style {
        size small
      }
      component API-endpoints 'API-endpoints' {
        description 'Ontvangt verzoeken, stuurt ze door en geeft een resultaat terug'
      }
      component authenticatie 'Authenticatie' {
        description 'Authenticeren wie het verzoek doet en of het mag'
      }
      component queryMaker 'Query maker' {
        description 'Vertaalt verzoeken naar een geldige database query'
      }
      component querySender 'Query verstuurder' {
        description 'Verstuurt de query naar de database en ontvangt het resultaat hiervan'
      }
      API-endpoints -> authenticatie
      API-endpoints -> queryMaker
      API-endpoints -> querySender
      querySender -> database
    }

    service MLservice 'ML service' {
      description '
        Voorspellen en adviseren op basis van gedragspatronen
      '
    }
  }

  // Customer uses the UI
  customer -> webapp 'opens in browser'
  customer -> saas 'enjoys our product'

  beheerder -> webapp 'Inzien en beheren software via'
  beheerder -> saas 'Beheert software'


  weerdata -> saas 'Geeft weerdata aan oplossing'
  weerdata -> MLservice 'Geeft weerdata aan oplossing'

  meterdata -> saas 'Geeft meterdata aan oplossing'
  meterdata -> ingestService 'Geeft meterdata aan oplossing'

  webapp -> frontendAPI 'Leest data vanuit database'
  frontendAPI -> database 'Lezen en schrijven naar database vanuit frontend'

  backendAPI -> database 'Lezen en schrijven naar database vanuit backend'

  ingestService -> backendAPI 'Schrijven van data naar database'
  MLservice -> backendAPI 'Lezen van data van database'
  rekenservice -> backendAPI 'Leest data van database om gelijktijdigheid te berekenen en schrijft deze terug naar database'
}


views {

  view index {
    title 'Context niveau'

    include *
  }

  view saas of saas {
    include *

    style * {
      opacity 25%
    }

        // Klikbare doorverwijzing naar niveau 3 per service
    include webapp with {
      navigateTo webappDetail
    }
    include ingestService with {
      navigateTo ingestDetail
    }
    include database with {
      navigateTo databaseDetail
    }
    include rekenservice with {
      navigateTo rekenDetail
    }
    include backendAPI with {
      navigateTo backendApiDetail
    }
    include frontendAPI with {
      navigateTo frontendApiDetail
    }

    style * {
      opacity 25%
    }
    style customer {
      color muted
    }
  }

  // Niveau 3: alleen de componenten van één service
  view webappDetail of webapp {
    title 'Web app componenten'
    include webapp.*
  }

  view ingestDetail of ingestService {
    title 'Ingest service componenten'
    include ingestService.*
  }

  view databaseDetail of database {
    title 'Database componenten'
    include database.*
  }

  view rekenDetail of rekenservice {
    title 'Reken service componenten'
    include rekenservice.*
  }

  view backendApiDetail of backendAPI {
    title 'Backend API componenten'
    include backendAPI.*
  }

  view frontendApiDetail of frontendAPI {
    title 'Frontend API componenten'
    include frontendAPI.*
  }
    style customer {
      color muted
    }
  }

  view componenten {
    title 'Alle componenten'
    include saas.**
    include customer, meterdata, weerdata, beheerder
  }

}
